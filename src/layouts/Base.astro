---
import "@/styles/global.css";
import { site } from "@/data/site";
import Masthead from "@/components/Masthead.astro";
import Colophon from "@/components/Colophon.astro";
import Sidebar from "@/components/Sidebar.astro";
import type { SectionId } from "@/lib/sections";
import { getImage } from "astro:assets";
import portrait from "@/assets/portrait.jpg";

interface Props {
  title?: string;
  description?: string;
  /** Pages other than home: which section of the wire they belong to. */
  section?: SectionId;
}

const { title, description = site.description, section } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: portrait, width: 1200, height: 1200, format: "jpg" });
const ogImage = new URL(og.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@masawhitestone" />

    <!-- Resolve the stored theme before first paint so the page never flashes. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* private mode, blocked storage — the media query still applies */
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-sm"
      >Skip to content</a
    >
    <span id="top"></span>
    <Masthead />
    <!-- Two panes on wide screens: identity and the section wire stay put on
         the left while the work scrolls on the right. -->
    <div class="mx-auto max-w-[88rem] px-6 lg:grid lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-14 lg:px-10">
      <Sidebar active={section} />
      <div class="min-w-0 lg:border-l lg:border-rule lg:pl-14">
        <main id="main">
          <slot />
        </main>
        <Colophon />
      </div>
    </div>
  </body>
</html>

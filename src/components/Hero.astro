---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "@/data/site";
import portrait from "@/assets/portrait.jpg";

const now = new Date();
const current = (await getCollection("experience"))
  .filter((entry) => !entry.data.end || entry.data.end > now)
  .sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
---

<!-- Narrow screens only: on wide screens the sidebar is the introduction. -->
<div class="pt-10 pb-12 lg:hidden">
  <Image
    src={portrait}
    alt={`Portrait of ${site.name}`}
    width={176}
    height={176}
    quality={90}
    loading="eager"
    class="mb-8 h-28 w-28 rounded-full border border-rule object-cover"
  />
  <h1 class="mb-4 text-5xl leading-[0.95] tracking-tight">Masaki<br />Shiraishi</h1>
  <p class="label mb-6">{site.title}</p>
  <p class="mb-8 font-serif text-xl leading-relaxed">{site.tagline}</p>
  <p class="label mb-2">Currently</p>
  <ul class="space-y-1 text-sm text-ink-muted">
    {
      current.map((entry) => (
        <li>
          <span class="text-ink">{entry.data.role}</span>
          <span class="text-ink-faint"> · {entry.data.organization}</span>
        </li>
      ))
    }
  </ul>
</div>

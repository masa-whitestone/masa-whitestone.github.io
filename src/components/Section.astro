---
interface Props {
  id?: string;
  /** Marginalia label — the small mono kicker set beside the heading. */
  label: string;
  title: string;
  /** Optional "see everything" affordance, right-aligned with the heading. */
  more?: { label: string; href: string };
}

const { id, label, title, more } = Astro.props;
---

<section id={id} class="border-t border-rule py-16 sm:py-20">
  <div class="mx-auto max-w-band px-6">
    <!-- Marginalia column on wide screens, stacked kicker on narrow ones. -->
    <div class="lg:grid lg:grid-cols-[7rem_1fr] lg:gap-10">
      <div class="label text-accent lg:pt-2 lg:text-right">{label}</div>

      <div>
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h2 class="text-2xl sm:text-3xl">{title}</h2>
          {
            more && (
              <a href={more.href} class="link text-sm text-ink-muted">
                {more.label}
              </a>
            )
          }
        </div>
        <slot />
      </div>
    </div>
  </div>
</section>

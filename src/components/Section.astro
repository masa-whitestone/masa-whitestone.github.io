---
import { sectionNumber, sectionTitle, type SectionId } from "@/lib/sections";

interface Props {
  id: SectionId;
  /** Optional "see everything" affordance, right-aligned with the heading. */
  more?: { label: string; href: string };
}

const { id, more } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-rule py-14 sm:py-16 lg:scroll-mt-8 lg:first-of-type:border-t-0 lg:first-of-type:pt-10">
  <header class="mb-10 flex flex-wrap items-center gap-x-4 gap-y-2">
    <!-- Same node as on the sidebar's wire, so heading and map visibly match. -->
    <span class="qnode shrink-0" data-section-node={id} data-state="future" aria-hidden="true"></span>
    <span class="font-mono text-xs tracking-wider text-accent">{sectionNumber(id)}</span>
    <h2 class="text-3xl sm:text-4xl">{sectionTitle(id)}</h2>
    {
      more && (
        <a href={more.href} class="link ml-auto text-sm text-ink-muted">
          {more.label}
        </a>
      )
    }
  </header>
  <slot />
</section>

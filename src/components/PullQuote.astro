---
interface Props {
  /** Verbatim words only — anything paraphrased belongs in `context`. */
  quote: string;
  attribution: string;
  context?: string;
  source?: { label: string; href: string };
}

const { quote, attribution, context, source } = Astro.props;
---

<aside class="border-t border-rule py-16 sm:py-20" aria-label="Quotation">
  <blockquote>
    <p class="font-serif text-3xl leading-tight text-balance sm:text-[2.6rem]">
      <span class="text-accent" aria-hidden="true">“</span>{quote}<span class="text-accent" aria-hidden="true">”</span>
    </p>
    <footer class="mt-6 max-w-measure text-sm text-ink-muted">
      <span class="text-ink">{attribution}</span>
      {context && <span> — {context}</span>}
      {
        source && (
          <>
            {" "}
            <a href={source.href} class="link" rel="noopener">
              {source.label}
            </a>
          </>
        )
      }
    </footer>
  </blockquote>
</aside>

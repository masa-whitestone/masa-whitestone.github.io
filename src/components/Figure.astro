---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Figure number as printed in the source, e.g. "Fig. 1". */
  number: string;
  caption: string;
  /** Where the figure was first published. */
  source?: { label: string; href: string };
}

const { src, alt, number, caption, source } = Astro.props;
---

<!-- A two-column journal figure needs more room than the prose band: this
     plate is deliberately wider than every other section on the page. -->
<section class="border-t border-rule py-12 sm:py-16">
  <div class="mx-auto max-w-[68rem] px-6">
    <a
      href={src.src}
      class="block border border-rule bg-white p-3 sm:p-5"
      aria-label={`${number} — open at full size`}
    >
      <Image
        src={src}
        alt={alt}
        widths={[720, 1080, 1600, 2200]}
        sizes="(min-width: 70rem) 65rem, 100vw"
        quality={92}
        loading="lazy"
        class="w-full"
      />
    </a>

    <figcaption class="mt-4 max-w-measure text-sm leading-relaxed text-ink-muted">
      <span class="font-mono text-xs tracking-wider text-accent uppercase">{number}</span>
      <span> {caption}</span>
      {
        source && (
          <>
            {" "}
            <a href={source.href} class="link whitespace-nowrap" rel="noopener">
              {source.label}
            </a>
          </>
        )
      }
      <span class="mt-1 block text-ink-faint">Click to view at full size.</span>
    </figcaption>
  </div>
</section>

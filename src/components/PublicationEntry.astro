---
import type { CollectionEntry } from "astro:content";
import BibtexButton from "@/components/BibtexButton.astro";

interface Props {
  entry: CollectionEntry<"publications">;
  /** Full entries add the abstract and BibTeX; compact ones are one-liners. */
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const p = entry.data;

const linkList = [
  p.links.arxiv && { label: `arXiv:${p.links.arxiv.split("/").pop()}`, href: p.links.arxiv },
  p.links.ieee && { label: "IEEE Xplore", href: p.links.ieee },
  p.links.doi && { label: "DOI", href: p.links.doi },
  p.links.pdf && { label: "PDF", href: p.links.pdf },
  p.links.code && { label: "Code", href: p.links.code },
].filter((l): l is { label: string; href: string } => Boolean(l));
---

<article class="py-6 first:pt-0">
  <div class="label mb-2">
    {p.venueShort ?? p.venue}
    {p.status !== "published" && <span class="text-accent"> · {p.status}</span>}
  </div>

  <h3 class="mb-2 font-serif text-lg leading-snug sm:text-xl">
    {p.title}
  </h3>

  <!-- Author line: the self entry is the only one that carries weight. -->
  <p class="mb-3 text-sm text-ink-muted">
    {
      p.authors.map((author, i) => (
        <>
          {i > 0 && ", "}
          <span class={author.self ? "font-medium text-ink" : undefined}>
            {author.name}
          </span>
        </>
      ))
    }
  </p>

  {
    !compact && (
      <p class="mb-4 text-sm text-ink-muted">
        {p.venue}, {p.year}
      </p>
    )
  }

  {
    !compact && p.abstract && (
      <details class="group mb-4">
        <summary class="label cursor-pointer list-none transition-colors hover:text-accent">
          <span class="group-open:hidden">Abstract +</span>
          <span class="hidden group-open:inline">Abstract −</span>
        </summary>
        <p class="mt-3 max-w-measure text-sm leading-relaxed text-ink-muted">
          {p.abstract}
        </p>
      </details>
    )
  }

  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    {
      linkList.map((link) => (
        <a href={link.href} class="link font-mono text-xs" rel="noopener">
          {link.label}
        </a>
      ))
    }
    {!compact && p.bibtex && <BibtexButton bibtex={p.bibtex} />}
  </div>
</article>

<style>
  /* Hide the native disclosure triangle across engines. */
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::marker {
    content: "";
  }
</style>

<!-- May appear more than once per page (sidebar, narrow-screen masthead), so
     it is found by attribute, never by id. -->
<button
  type="button"
  data-theme-toggle
  class="label cursor-pointer transition-colors hover:text-accent"
  aria-label="Toggle colour theme"
>
  <span data-theme-toggle-label>Theme</span>
</button>

<script>
  const active = (): "dark" | "light" => {
    const explicit = document.documentElement.dataset.theme;
    if (explicit === "dark" || explicit === "light") return explicit;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };

  // Each button is named for the theme it switches *to*.
  const render = () => {
    const next = active() === "dark" ? "Light" : "Dark";
    document.querySelectorAll("[data-theme-toggle-label]").forEach((el) => (el.textContent = next));
  };

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const next = active() === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* nothing to persist to — the toggle still works for this page view */
      }
      render();
    });
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", render);
  render();
</script>

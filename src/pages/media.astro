---
import { getMediaStories } from "@/lib/media";
import Base from "@/layouts/Base.astro";
import MediaEntry from "@/components/MediaEntry.astro";
import PageHeader from "@/components/PageHeader.astro";

const media = await getMediaStories();
---

<Base
  section="media"
  title="Media"
  description="Press coverage, interviews and commentary featuring Masaki Shiraishi."
>
  <PageHeader
    label="Media"
    title="Media"
    intro="Coverage in which I was interviewed, quoted, or otherwise mentioned."
  />

  <div class="pb-16">
    <div class="divide-y divide-rule">
      {media.map((story) => <MediaEntry {...story} />)}
    </div>
  </div>
</Base>

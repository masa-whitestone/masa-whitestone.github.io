---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import MediaEntry from "@/components/MediaEntry.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import { links, cv } from "@/data/site";
import { formatMonth } from "@/lib/format";

const research = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order,
);

const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const media = (await getCollection("media")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const awards = (await getCollection("awards")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const experience = (await getCollection("experience")).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

// The masthead of the front page: the three most recent things worth knowing,
// drawn from whichever collection they happen to live in.
const highlights = [
  ...awards.map((a) => ({
    date: a.data.date,
    label: "Award",
    title: a.data.title,
    detail: a.data.organization,
    href: a.data.url,
  })),
  ...media.map((m) => ({
    date: m.data.date,
    label: m.data.outlet,
    title: m.data.title,
    detail: "Quoted in this news article",
    href: m.data.url,
  })),
  ...publications.map((p) => ({
    date: p.data.date,
    label: "Publication",
    title: p.data.title,
    detail: p.data.venueShort ?? p.data.venue,
    href: "/publications",
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

const researchBodies = await Promise.all(
  research.map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---

<Base>
  <Hero />

  <Section id="highlights" label="Recent" title="Selected">
    <ol class="divide-y divide-rule">
      {
        highlights.map((item) => (
          <li class="grid gap-1 py-5 first:pt-0 last:pb-0 sm:grid-cols-[12rem_1fr] sm:gap-6">
            <div class="label sm:pt-1">
              {formatMonth(item.date)} · {item.label}
            </div>
            <div>
              <h3 class="font-serif text-lg leading-snug">
                {item.href ? (
                  <a href={item.href} class="link" rel="noopener">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              <p class="text-sm text-ink-muted">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="research" label="01" title="Research">
    <div class="space-y-10">
      {
        researchBodies.map(({ entry, Content }) => (
          <article>
            <h3 class="mb-1 font-serif text-xl">{entry.data.title}</h3>
            <p class="mb-3 max-w-measure font-serif text-ink-muted italic">
              {entry.data.summary}
            </p>
            <div class="max-w-measure space-y-3 text-sm leading-relaxed text-ink-muted">
              <Content />
            </div>
            {entry.data.keywords.length > 0 && (
              <p class="label mt-3">{entry.data.keywords.join(" · ")}</p>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  <Section
    id="publications"
    label="02"
    title="Publications"
    more={publications.length > 2 ? { label: "All publications", href: "/publications" } : undefined}
  >
    <div class="divide-y divide-rule">
      {publications.slice(0, 3).map((entry) => <PublicationEntry entry={entry} />)}
    </div>
  </Section>

  <Section
    id="media"
    label="03"
    title="Media"
    more={media.length > 3 ? { label: "All media", href: "/media" } : undefined}
  >
    <div class="divide-y divide-rule">
      {media.slice(0, 3).map((entry) => <MediaEntry entry={entry} />)}
    </div>
  </Section>

  <Section id="experience" label="04" title="Experience">
    <ExperienceList entries={experience} />
  </Section>

  <Section id="awards" label="05" title="Awards & Programs">
    <ol class="divide-y divide-rule">
      {
        awards.map((entry) => {
          const a = entry.data;
          return (
            <li class="grid gap-1 py-5 first:pt-0 last:pb-0 sm:grid-cols-[12rem_1fr] sm:gap-6">
              <div class="label sm:pt-1">{a.year}</div>
              <div>
                <h3 class="font-serif text-lg leading-snug">
                  {a.url ? (
                    <a href={a.url} class="link" rel="noopener">
                      {a.title}
                    </a>
                  ) : (
                    a.title
                  )}
                  {a.titleJa && (
                    <span class="ml-2 text-sm text-ink-faint">{a.titleJa}</span>
                  )}
                </h3>
                <p class="text-sm text-ink-muted">{a.organization}</p>
                {a.note && (
                  <p class="mt-1 max-w-measure text-sm text-ink-muted">{a.note}</p>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </Section>

  <Section id="contact" label="06" title="Contact">
    <p class="mb-8 max-w-measure font-serif text-lg text-ink">
      Feel free to reach out for collaboration or discussion.
    </p>

    <ul class="grid gap-x-10 gap-y-3 sm:grid-cols-2">
      {
        links.map((link) => (
          <li class="flex flex-wrap items-baseline gap-x-3">
            <a href={link.href} class="link text-sm" rel="noopener">
              {link.label}
            </a>
            {link.handle && (
              <span class="font-mono text-xs text-ink-faint">{link.handle}</span>
            )}
          </li>
        ))
      }
      {
        cv.available && (
          <li>
            <a href={cv.href} class="link text-sm">
              Curriculum Vitae (PDF)
            </a>
          </li>
        )
      }
    </ul>
  </Section>
</Base>

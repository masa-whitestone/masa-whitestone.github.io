---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import MediaEntry from "@/components/MediaEntry.astro";
import TalkEntry from "@/components/TalkEntry.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import Figure from "@/components/Figure.astro";
import PullQuote from "@/components/PullQuote.astro";
import Icon from "@/components/Icon.astro";
import { site, links, cv } from "@/data/site";
import { formatMonth } from "@/lib/format";

const research = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order,
);

const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const talks = (await getCollection("talks")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const media = (await getCollection("media")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const awards = (await getCollection("awards")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const experience = (await getCollection("experience")).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

// The masthead of the front page: the three most recent things worth knowing,
// drawn from whichever collection they happen to live in.
const highlights = [
  ...awards.map((a) => ({
    date: a.data.date,
    label: "Award",
    title: a.data.title,
    detail: a.data.program ?? a.data.organization,
    href: a.data.url,
  })),
  ...media.map((m) => ({
    date: m.data.date,
    label: m.data.outlet,
    title: m.data.title,
    detail: "Quoted in this news article",
    href: m.data.url,
  })),
  ...publications.map((p) => ({
    date: p.data.date,
    label: "Publication",
    title: p.data.title,
    detail: p.data.venueShort ?? p.data.venue,
    href: "/publications",
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

const researchBodies = await Promise.all(
  research.map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---
<Base>
  <Hero />

  <Section id="selected">
    <ol>
      {
        highlights.map((item) => (
          <li class="grid gap-2 border-t border-rule py-7 first:border-t-0 first:pt-0 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-8">
            <div class="label md:pt-2.5">
              {formatMonth(item.date)}
              <br class="hidden md:block" />
              <span class="text-accent md:mt-1 md:inline-block"> {item.label}</span>
            </div>
            <div>
              <h3 class="font-serif text-2xl leading-tight sm:text-[1.9rem]">
                {item.href ? (
                  <a href={item.href} class="link decoration-transparent hover:decoration-accent" rel="noopener">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              <p class="mt-2 max-w-2xl text-sm text-ink-muted">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="research">
    {
      researchBodies.map(({ entry, Content }, i) => (
        <article class="grid gap-6 border-t border-rule py-10 first:border-t-0 first:pt-0 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] xl:gap-12">
          <div>
            <p class="mb-3 font-mono text-xs text-accent">R{i + 1}</p>
            <h3 class="mb-3 font-serif text-[1.75rem] leading-tight">{entry.data.title}</h3>
            <p class="font-serif text-lg leading-snug text-ink-muted italic">{entry.data.summary}</p>
            {entry.data.keywords.length > 0 && (
              <p class="label mt-5">{entry.data.keywords.join(" · ")}</p>
            )}
          </div>
          <div class="max-w-measure space-y-3 text-[0.95rem] leading-relaxed text-ink-muted xl:pt-8">
            <Content />
          </div>
        </article>
      ))
    }

    {
      research
        .filter((entry) => entry.data.figure)
        .map((entry) => (
          <Figure
            src={entry.data.figure!.src}
            alt={entry.data.figure!.alt}
            number={entry.data.figure!.number}
            caption={entry.data.figure!.caption}
            source={
              entry.data.figure!.sourceLabel && entry.data.figure!.sourceHref
                ? { label: entry.data.figure!.sourceLabel, href: entry.data.figure!.sourceHref }
                : undefined
            }
          />
        ))
    }
  </Section>

  <PullQuote
    quote="not yet a fully autonomous scientist"
    attribution="Masaki Shiraishi"
    context="on Pasqal’s AI system for quantum computing"
    source={{ label: "Nature, 19 August 2026", href: "https://www.nature.com/articles/d41586-026-02495-4" }}
  />

  <Section
    id="publications"
    more={publications.length > 2 ? { label: "All publications", href: "/publications" } : undefined}
  >
    <div class="divide-y divide-rule">
      {publications.slice(0, 3).map((entry) => <PublicationEntry entry={entry} />)}
    </div>
  </Section>

  <Section id="talks">
    <div class="divide-y divide-rule">
      {talks.map((entry) => <TalkEntry entry={entry} />)}
    </div>
  </Section>

  <Section id="media" more={media.length > 3 ? { label: "All media", href: "/media" } : undefined}>
    <div class="divide-y divide-rule">
      {media.slice(0, 3).map((entry) => <MediaEntry entry={entry} />)}
    </div>
  </Section>

  <Section id="experience">
    <ExperienceList entries={experience} />
  </Section>

  <Section id="awards">
    <ol class="divide-y divide-rule">
      {
        awards.map((entry) => {
          const a = entry.data;
          return (
            <li class="grid gap-1 py-6 first:pt-0 last:pb-0 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-8">
              <div class="label sm:pt-1">{a.year}</div>
              <div>
                <h3 class="font-serif text-xl leading-snug">
                  {a.url ? (
                    <a href={a.url} class="link" rel="noopener">
                      {a.title}
                    </a>
                  ) : (
                    a.title
                  )}
                </h3>
                {a.program && <p class="text-sm text-ink">{a.program}</p>}
                {a.titleJa && <p class="text-sm text-ink-faint">{a.titleJa}</p>}
                <p class="mt-1 text-sm text-ink-muted">{a.organization}</p>
                {a.context && <p class="max-w-measure text-sm text-ink-faint">{a.context}</p>}
                {a.note && <p class="mt-1 max-w-measure text-sm text-ink-muted">{a.note}</p>}
              </div>
            </li>
          );
        })
      }
    </ol>
  </Section>

  <Section id="contact">
    <p class="mb-3 max-w-xl font-serif text-[1.9rem] leading-tight text-ink">
      Feel free to reach out for collaboration or discussion.
    </p>
    <p class="mb-10">
      <a href={`mailto:${site.email}`} class="link font-mono text-sm">{site.email}</a>
    </p>

    <ul class="flex flex-wrap gap-x-7 gap-y-6">
      {
        [
          ...links,
          ...(cv.available
            ? [{ label: "CV", icon: "cv" as const, href: cv.href, handle: "Curriculum Vitae (PDF)" }]
            : []),
        ].map((link) => (
          <li>
            <a
              href={link.href}
              class="group flex w-16 flex-col items-center gap-2 text-ink-muted transition-colors hover:text-accent"
              rel={link.href.startsWith("http") ? "noopener" : undefined}
              title={link.handle ?? link.label}
              aria-label={link.handle ? `${link.label}: ${link.handle}` : link.label}
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-full border border-rule transition-colors group-hover:border-accent">
                <Icon name={link.icon} class="h-5 w-5" />
              </span>
              <span class="label text-center leading-tight transition-colors group-hover:text-accent">
                {link.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
